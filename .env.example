# 认证跳板配置（pm-assist）：client_id/secret 需与 pm-assist .env 中 HUB_CLIENTS 的注册一致
HUB_URL=https://pm.tmhcorps.cn
HUB_CLIENT_ID=wikilogger
HUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 应用密钥（生成随机字符串）
SECRET_KEY=your-random-secret-key-here

# 「打开原文」链接使用的飞书域名（建议填企业域名）
# FEISHU_WEB_BASE=https://xxx.feishu.cn

# 数据库与本地镜像目录（Docker 部署由 docker-compose.yml 覆盖为 /app/data、/app/cache）
# DB_PATH=./wikilogger.db
# LOCAL_CACHE_DIR=./cache

# 单个图片 / 附件 / 导出文件大小上限（MB）
# MAX_ATTACHMENT_SIZE_MB=50
# 是否下载文档内图片、文档内附件
# CACHE_DOC_IMAGES=true
# CACHE_DOC_FILES=true
# 是否把电子表格 / 多维表格导出为 xlsx、旧版文档导出为 docx（需 drive:export:readonly）
# EXPORT_OFFICE_FILES=true
# 是否下载知识库里直接上传的文件（需 drive:file:download）
# DOWNLOAD_WIKI_FILES=true
# 飞书侧删除的节点：true 移入 _deleted/ 保留最后一版，false 直接删除
# KEEP_DELETED=true

# 限速（按飞书应用计，与 chatlogger 等共用 pm-assist 应用配额；官方上限：知识库 100 次/分，docx 5 次/秒）
# WIKI_API_PER_MIN=80
# DOCX_API_PER_SEC=4
# DRIVE_DOWNLOAD_PER_SEC=4
# EXPORT_API_PER_MIN=80
# FETCH_CONCURRENCY=3

# HOST=0.0.0.0
# PORT=5000
# DEBUG=false
